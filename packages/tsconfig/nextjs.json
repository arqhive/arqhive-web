{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js 앱",
  "extends": "./base.json",
  "compilerOptions": {
    // 브라우저 API(document, window 등) 타입을 더한다.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    // JSX 변환은 Next.js(SWC)가 하므로 TS는 그대로 둔다.
    "jsx": "preserve",
    "allowJs": false,
    // 이전 검사 결과를 저장해 다음 검사를 빠르게 한다(.tsbuildinfo).
    "incremental": true,
    // 편집기에서 Next.js 전용 검사(예: 서버 컴포넌트 규칙)를 보여 준다.
    "plugins": [{ "name": "next" }]
  }
}
