{
  "$schema": "https://turborepo.com/schema.json",
  // 터미널에서 작업별 로그를 탭으로 나눠 보여 준다.
  "ui": "tui",
  // AI 에이전트가 명령을 실행할 때 루트에 AGENTS.md를 자동으로 만드는 기능을 끈다.
  "agentGuidance": false,
  // 각 패키지의 package.json scripts 중 같은 이름을 가진 것을 "작업"으로 묶어 실행한다.
  "tasks": {
    "build": {
      // ^ 는 "내가 의존하는 패키지의 같은 작업을 먼저"라는 뜻이다(예: web 빌드 전에 shared 빌드).
      // ^types: web이 쓰는 API 타입 선언(.d.ts)을 먼저 만든다(Hono RPC 클라이언트).
      "dependsOn": ["^build", "^types"],
      // 빌드 결과에 영향을 주는 환경 변수. 값이 바뀌면 캐시를 쓰지 않고 다시 빌드한다(진열장 다운로드 수용 GitHub 토큰).
      "env": ["GITHUB_TOKEN"],
      // 실행할 때만 읽고 빌드 결과에는 영향이 없는 값(서버 오류 알림 웹훅). 캐시 키에는 넣지 않고 그대로 넘긴다
      "passThroughEnv": ["DISCORD_WEBHOOK_URL"],
      // 캐시에 저장할 결과물. 입력이 같으면 다음엔 빌드하지 않고 이걸 되살린다.
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".velite/**", "public/fonts/**"]
    },
    // 콘텐츠 패키지는 자기 폴더 밖(저장소 맨 위 content/)의 MDX를 읽는다. turbo는 기본으로 패키지 폴더 안 파일만
    // 입력으로 보므로, content/를 입력에 넣지 않으면 MDX만 바꾼 커밋을 "바뀐 것 없음"으로 보고 옛 빌드를 되살린다
    // (10/7 Vercel 원격 캐시로 패치 공개가 반영되지 않음). web은 이 패키지에 의존하므로 함께 다시 빌드된다.
    "@arqhive/content#build": {
      "dependsOn": ["^build", "^types"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/**"],
      "outputs": [".velite/**"]
    },
    "@arqhive/content#typecheck": {
      "dependsOn": ["^typecheck", "^types"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/content/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^types"]
    },
    // api가 web에 내보내는 타입 선언(apps/api/types). 이 스크립트가 있는 패키지(api)에서만 돈다
    "types": {
      "outputs": ["types/**"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    // web에만 있는 작업(Steiger). 의존 순서가 필요 없다.
    "lint:fsd": {},
    "dev": {
      // 개발 서버는 결과물이 없고 계속 켜져 있으므로 캐시하지 않는다.
      "cache": false,
      "persistent": true
    }
  }
}
