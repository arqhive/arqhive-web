{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Seoul",
  "schedule": ["before 9am on monday"],
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "작은 업데이트는 한 PR로 묶는다",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch"
    },
    {
      "description": "TypeScript 7(네이티브 컴파일러)은 도구 호환을 확인한 뒤 올린다",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "@cloudflare/vitest-pool-workers가 지원할 때까지 Vitest 4에 머문다",
      "matchPackageNames": ["vitest"],
      "allowedVersions": "<5"
    }
  ]
}
