{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/worker-configuration.d.ts", "!docs/design"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      // Tailwind v4 문법(@theme, @custom-variant 등)을 읽을 수 있게 한다.
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    // 이 프로젝트가 쓰는 기술의 규칙 묶음은 전부 켜고, 쓰지 않는 프레임워크 묶음은 끈다.
    "domains": {
      "react": "all",
      "next": "all",
      "project": "all",
      "types": "all",
      "test": "all",
      "playwright": "all",
      "drizzle": "all",
      "tailwind": "all",
      "turborepo": "all",
      "solid": "none",
      "qwik": "none",
      "vue": "none",
      "svelte": "none",
      "astro": "none",
      "reactNative": "none"
    },
    // 최대한 엄격하게: 모든 규칙을 켜고(실험 단계인 nursery 제외), 전부 오류로 처리한다.
    "rules": {
      "preset": "all",
      "a11y": "error",
      "complexity": "error",
      "correctness": "error",
      "performance": "error",
      "security": "error",
      "style": "error",
      "suspicious": "error"
    }
  },
  "overrides": [
    {
      // 공용 TS 설정 파일은 이름이 tsconfig.json이 아니라 Biome이 일반 JSON으로 본다. TS는 주석을 허용하므로 맞춰 준다.
      "includes": ["packages/tsconfig/*.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    },
    {
      // 프로젝트 전체에서 끄는 규칙. 끌 때마다 이유를 적는다. (ADR 0007)
      "includes": ["**"],
      "linter": {
        "rules": {
          "performance": {
            // FSD는 조각마다 공개 창구(index.ts)로 다시 내보내기를 요구한다. 경계 검사는 Steiger가 맡는다.
            "noBarrelFile": "off",
            // 그룹 전체를 오류로 켜면 domains에서 끈 Solid 규칙도 다시 켜진다. React JSX에 잘못 걸리므로 끈다.
            "useSolidForComponent": "off",
            // props에 인라인 함수 금지. React 공식 문서상 인라인 함수 자체는 문제가 아니고, 지키려면 모든 곳에 useCallback이 필요하다.
            // 성능 문제가 실제로 측정되면 그 지점만 대응한다.
            "noJsxPropsBind": "off"
          },
          "correctness": {
            // FSD 조각은 폴더 단위로 가져온다(@/pages/home). 상대 경로는 확장자를 직접 붙여 쓴다.
            "useImportExtensions": "off",
            // Solid·Qwik 전용 규칙(위와 같은 이유). Vue 규칙은 .vue 파일에만 걸리므로 그대로 둔다.
            "noSolidDestructuredProps": "off",
            "noQwikUseVisibleTask": "off",
            "useQwikClasslist": "off",
            "useQwikMethodUsage": "off",
            "useQwikValidLexicalScope": "off"
          },
          "style": {
            // 다국어 계획이 없다. 화면 문구는 컴포넌트 옆에 두는 편이 읽기 쉽다.
            "noJsxLiterals": "off",
            // 삼항 연산자 전면 금지. React의 조건부 렌더링·조건부 클래스의 기본 문법이라, 금지하면 더 읽기 어려운 우회 코드가 생긴다.
            "noTernary": "off"
          }
        }
      }
    },
    {
      // 디자인 토큰을 정의하는 유일한 파일. 다른 곳에서는 16진수 색을 쓰지 못하게 해서 토큰 사용을 강제한다.
      "includes": [
        "apps/web/src/app/styles/globals.css",
        // 케이스 재질: 실물 플라스틱·디스크 색이라 토큰이 아닌 고정 색을 쓴다
        "apps/web/src/entities/patch/ui/case-materials.css",
        "apps/web/src/entities/patch/ui/cart-materials.css",
        "apps/web/src/entities/patch/ui/paper-materials.css",
        // 책장 나무·금속 색
        "apps/web/src/widgets/shelf/ui/shelf-materials.css",
        // 홀로그램 무지개 색
        "apps/web/src/shared/ui/holo-text.css"
      ],
      "linter": {
        "rules": {
          "style": {
            "noHexColors": "off"
          }
        }
      }
    },
    {
      // 에이전트(지시문·도구 설명·답변 문구가 대부분 한국어 문장): 비밀값 추정 규칙이 한국어 문장을 비밀값으로 잘못 본다.
      // 이 폴더에는 비밀값이 없다(키는 env로만 받는다).
      "includes": [
        "apps/api/src/modules/agent/**",
        "apps/api/eval/**",
        "apps/api/test/agent*.test.ts"
      ],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      // 운영 상태 스크립트(pnpm ops): 화면 표시용 숫자(자리수·시간 단위)와 한글 항목 이름이 많아
      // 숫자 상수 규칙과 비밀값 추정 규칙(한글 문장을 비밀값으로 잘못 봄)을 끈다. 비밀값은 환경 변수로만 받고 출력하지 않는다.
      "includes": ["scripts/ops.mjs", "apps/api/eval/run.mjs"],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off",
            // 평가는 사례를 하나씩 차례로 돌린다(모델 한도·속도 때문에 일부러 순서대로)
            "noContinue": "off"
          },
          "performance": {
            "noAwaitInLoops": "off"
          },
          "security": {
            "noSecrets": "off"
          },
          "suspicious": {
            // turbo 작업이 아니라 손으로 돌리는 스크립트라 환경 변수가 캐시와 상관없다
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      // 빌드 보조 스크립트(예: apps/web/scripts/copy-fonts.mjs)와 drizzle-kit 설정: 브라우저가 아니라 Node.js에서 도는 파일이라
      // node: 내장 모듈·환경 변수를 쓰고, 무엇을 했는지 터미널에 한 줄 남긴다.
      "includes": [
        "scripts/**",
        "apps/*/scripts/**",
        "apps/api/eval/**",
        "packages/db/drizzle.config.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      // Next.js 라우팅 규약 파일: 기본 내보내기와 metadata 같은 컴포넌트 외 내보내기가 규약상 필요하다.
      "includes": ["apps/web/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      // 도구 설정 파일과 Workers 진입점: 도구가 기본 내보내기를 읽는다.
      "includes": ["**/*.config.ts", "**/*.config.mjs", "apps/api/src/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      // 테스트: 기대값(상태 코드 등)을 숫자 그대로 적는 편이 읽기 쉽다.
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      // 화면 검사(Playwright): 설정·테스트는 Node에서 돈다(process.env.CI로 CI인지 가림).
      // @playwright/test는 이름을 다른 패키지에서 다시 내보내 Biome이 따라가지 못한다(없는 이름이라는 오탐).
      // 한글 테스트 이름·기대 문장을 비밀값으로 잘못 보고, 테스트 안 정규식은 한 번만 쓰여 맨 위로 뺄 이유가 없다.
      "includes": ["apps/web/e2e/**", "apps/web/playwright.config.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noUnresolvedImports": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          },
          "security": {
            "noSecrets": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    }
  ]
}
