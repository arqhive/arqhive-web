{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare에 배포될 Worker 이름. 주소는 arqhive-api.<계정>.workers.dev가 된다.
  "name": "arqhive-api",
  "main": "src/index.ts",
  // Workers 런타임의 동작 기준일. 이 날짜 이후에 바뀐 런타임 동작은 적용되지 않아서, 배포해도 갑자기 동작이 바뀌지 않는다.
  "compatibility_date": "2026-10-01",
  // Node.js 내장 모듈(일부)을 쓸 수 있게 한다. 여러 npm 패키지가 이걸 기대한다.
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare 대시보드에서 요청 로그(Workers Logs)를 볼 수 있게 한다.
  "observability": {
    "enabled": true
  },
  // 공개 설정값(비밀 아님). 비밀값(TURNSTILE_SECRET_KEY, GITHUB_ISSUES_TOKEN)은 여기 두지 않는다:
  // 개발은 .dev.vars 파일(git 제외), 배포는 `wrangler secret put 이름`으로 Cloudflare에 넣는다.
  "vars": {
    // 제보 양식을 보낼 수 있는 사이트(CORS). 쉼표로 여러 개. 도메인을 사면 여기에 더한다.
    "ALLOWED_ORIGINS": "http://localhost:3000,https://arqhive.vercel.app",
    // 제보 스크린샷을 올린 R2 버킷 arqhive-reports의 공개 주소(끝의 / 없이). 이슈 본문의 이미지 링크가 된다.
    // 개발(wrangler dev)은 PC 안의 가짜 버킷이라 이 주소로는 안 보이므로, .dev.vars에서 API의 /api/reports/images로 덮어쓴다.
    // r2.dev 주소는 개발용이라 요청 수 제한이 있다. 사이트 도메인이 정해지면 버킷에 사용자 지정 도메인을 연결해 바꾼다.
    "REPORT_IMAGE_BASE_URL": "https://pub-032e2a3dea5c4e4c89f0c7196a9606ca.r2.dev",
    // "1"이면 GitHub 이슈를 만들지 않고 가짜 주소를 돌려준다. 배포된 서버는 "0"(실제로 만든다).
    // 개발 PC는 .dev.vars의 REPORT_DRY_RUN=1이 이 값을 덮어써서, 시험 중 공개 저장소에 이슈가 생기지 않는다.
    "REPORT_DRY_RUN": "0"
  },
  // 제보 스크린샷 저장소. 개발(wrangler dev)에서는 PC 안의 가짜 버킷을 쓴다.
  "r2_buckets": [{ "binding": "REPORT_IMAGES", "bucket_name": "arqhive-reports" }],
  // 요청 횟수 세기(IP별 시간당, 사이트 전체 하루)와 R2 저장 용량 누적. 개발(wrangler dev)에서는 PC 안의 가짜 저장소를 쓴다.
  // id는 `wrangler kv namespace create RATE_LIMIT`로 만든 Cloudflare KV(비밀값 아님).
  "kv_namespaces": [{ "binding": "RATE_LIMIT", "id": "fd69a10501a74b84841533334a70b85f" }]
  // Queues·Cron·Workers AI·Vectorize 바인딩은 각 기능을 만드는 단계에서 추가한다.
  // 바인딩을 추가하면 `pnpm --filter @arqhive/api typegen`으로 Env 타입을 다시 만든다.
}
