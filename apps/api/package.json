{
  "name": "@arqhive/api",
  "version": "0.0.0",
  "private": true,
  "description": "arqhive API — Hono on Cloudflare Workers",
  "type": "module",
  "exports": {
    "./app-type": {
      "types": "./types/app.d.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typegen": "wrangler types --strict-vars=false",
    "types": "wrangler types --strict-vars=false && tsc -p tsconfig.types.json",
    "typecheck": "wrangler types --strict-vars=false && tsc --noEmit",
    "test": "vitest run",
    "agent:eval": "node eval/run.mjs"
  },
  "dependencies": {
    "@arqhive/content": "workspace:*",
    "@arqhive/db": "workspace:*",
    "@arqhive/shared": "workspace:*",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12"
  },
  "devDependencies": {
    "@arqhive/tsconfig": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
